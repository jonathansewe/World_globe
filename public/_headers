# Cloudflare Pages response headers. Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Pinned files never change under the same name: cache for a year.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/data/history/*
  Cache-Control: public, max-age=31536000, immutable

# Generated data is refreshed by scheduled Actions: cache for an hour.
/data/*.json
  Cache-Control: public, max-age=3600
